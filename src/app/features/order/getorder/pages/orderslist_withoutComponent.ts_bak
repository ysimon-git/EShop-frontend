
import { Component, inject, OnInit, signal } from '@angular/core';
import { CommonModule } from '@angular/common';
import { OrderService } from '../../services/order.service';
import { AuthService } from '../../../auth/services/auth.service'; // Adapter le chemin
import { OrderSummary } from '../models/order-summary.model';
import { OrderDetails } from '../models/order-details.model';
import { environment } from '../../../../../environments/environment';
import { OrderItems } from '../components/orderitems/order-items';

@Component({
  selector: 'app-orderslist',
  standalone: true,
  imports: [CommonModule, OrderItems],
  templateUrl: './orderslist.html',
  styleUrl: './orderslist.css'
})
export class Orderslist implements OnInit {

  private orderService = inject(OrderService);
  private authService = inject(AuthService);

  orders = signal<OrderSummary[]>([]);
  loading = signal(false);
  error = signal<string | null>(null);
  
  selectedOrderId = signal<string | null>(null);
  selectedOrder = signal<OrderDetails | null>(null);
  loadingDetails = signal(false);

  ngOnInit(): void {
    this.loadOrders();
  }

  loadOrders(): void {

    const customerId = this.authService.getCustomerId();
    console.log("in loadOrders, customerid=",customerId);

    if (!customerId) {
      this.error.set('Utilisateur non identifié.');
      return;
    }

    this.loading.set(true);
    this.error.set(null);

    this.orderService.getOrdersByCustomerId(customerId)
      .subscribe({
        next: (orders) => {
          this.orders.set(orders);
          this.loading.set(false);
        },
        error: () => {
          this.error.set('Impossible de charger les commandes.');
          this.loading.set(false);
        }
      });
  }


  


    selectOrder(orderId: string): void {

      // Close the details if the same order is clicked
      if (this.selectedOrderId() === orderId) {
        this.selectedOrderId.set(null);
        this.selectedOrder.set(null);
        return;
      }

      this.selectedOrderId.set(orderId);
      this.selectedOrder.set(null);
      this.loadingDetails.set(true);

      this.orderService.getOrderById(orderId).subscribe({
        next: (order) => {
          // Ignore a response if another order was selected
          if (this.selectedOrderId() !== orderId) return;

          this.selectedOrder.set(order);
          this.loadingDetails.set(false);
        },
        error: () => {
          if (this.selectedOrderId() !== orderId) return;

          this.loadingDetails.set(false);
          this.error.set('Impossible de charger le détail.');
        }
      });
    }


    getImageUrl(imageUrl: string): string {
        return `${environment.apiUrls.catalogImages}/${imageUrl.replace(/^\/+/, '')}`;
    }

}
